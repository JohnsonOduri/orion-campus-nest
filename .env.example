# ORION environment configuration (example)
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Variable NAMES only here — no secrets belong in this file.

# -----------------------------------------------------------------------------
# Supabase — server / service-role configuration  (NEVER expose to the browser)
# -----------------------------------------------------------------------------
# Used by: backend/timetable Python ingestion (repository.py), admin tooling.
# The service-role key BYPASSES ROW LEVEL SECURITY. It must only live in
# server-side environments and is never imported into client bundles.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<service-role / secret key — server only>
# Management API token (supabase.com dashboard → account → access tokens).
# Used only by server-side admin tooling (scripts/supabase_sql.py). Optional.
SUPABASE_ACCESS_TOKEN=<personal access token — server only>
# Legacy alias for the same secret (either works; SUPABASE_SECRET_KEY preferred):
SUPABASE_SERVICE_ROLE_KEY=<service-role key — server only>

# -----------------------------------------------------------------------------
# Supabase — client / public configuration  (safe for browser bundles)
# -----------------------------------------------------------------------------
# Used by: request-scoped API clients (backend/app/services/supabase_clients.py,
# backend/query/) that forward the caller's verified JWT on the public anon
# key so auth.uid() and RLS apply. The anon key is designed to be public;
# security comes from RLS + JWTs.
SUPABASE_ANON_KEY=<public anon / publishable key>
# Optional aliases already used elsewhere in the repo:
SUPABASE_PUBLIC_ANON_KEY=<public anon key>
SUPABASE_PUBLISHABLE_KEY=<publishable key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public anon key>
PUBLIC_SUPABASE_ANON_KEY=<public anon key>

# -----------------------------------------------------------------------------
# Authentication — Google OAuth (docs/auth.md)
# -----------------------------------------------------------------------------
# Configured on the Supabase project itself (Auth > Providers > Google), not
# read by the app at runtime — kept here only so the pair is documented
# somewhere. Never put the secret in a VITE_/PUBLIC_ variable.
GOOGLE_CLIENT_ID=<Google OAuth client id>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret — server-side / Supabase dashboard only>

# -----------------------------------------------------------------------------
# LLM + embeddings: see the GEMINI_API_KEY entry in the FastAPI section below.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Example variable-purpose matrix
# -----------------------------------------------------------------------------
# SUPABASE_URL / SUPABASE_SECRET_KEY      Python ingestion CLI (--import), admin
# SUPABASE_URL / SUPABASE_ANON_KEY        request-scoped timetable/chat API clients
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY   browser Supabase client (Google
#                                               sign-in, cookie session — src/lib/
#                                               supabase-browser.ts, docs/auth.md)

# Rule of thumb (AGENTS.md §15/§32): if leaking a variable would let someone
# read or write data they should not, it is a server secret — keep it out of
# anything shipped to the browser.

# -----------------------------------------------------------------------------
# ORION FastAPI backend (backend/main.py + backend/app/) — local/dev only for now
# -----------------------------------------------------------------------------
# Reads this same repo-root .env (see backend/app/core/config.py). Never uses
# the service-role key to serve a user request — every route forwards the
# caller's own Supabase JWT via a request-scoped client (D6).
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:8080
# Set to "true" only once the app is served over https.
COOKIE_SECURE=false

# Google OAuth — the sign-in flow itself is frontend-driven (src/lib/
# supabase-browser.ts, src/routes/login.tsx, src/routes/auth.callback.tsx);
# these are configured on the Supabase project (Auth > Providers > Google),
# not read by the backend at runtime. The frontend's own origin callback,
# e.g. http://localhost:8080/auth/callback, must be added to Supabase
# Dashboard → Authentication → URL Configuration → Redirect URLs.
GOOGLE_CLIENT_ID=<google oauth client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>

# Gemini — generation (backend/query/llm_client.py) AND embeddings
# (backend/query/embeddings.py, gemini-embedding-2, 768-dim; docs/embeddings.md).
# Server only: the API and the ingestion/backfill scripts. Never VITE_/PUBLIC_.
# Without it, structured answers still work; semantic/hybrid retrieval
# degrades to a "temporarily unavailable" warning and /ai/ask returns
# generation_available: false — nothing crashes.
GEMINI_API_KEY=<Google AI Studio Gemini API key — server only>
# Optional embedding knobs (defaults shown). "minilm" is the rollback path
# only and needs backend/requirements-minilm-rollback.txt.
# ORION_EMBEDDING_PROVIDER=gemini
# ORION_EMBED_BATCH_SIZE=16
# ORION_EMBED_TEXTS_PER_MINUTE=90

# -----------------------------------------------------------------------------
# Frontend — browser-safe
# -----------------------------------------------------------------------------
# Where the browser sends auth/CR/admin API calls (backend/main.py). Not a
# Supabase variable — the browser no longer talks to Supabase directly.
VITE_API_BASE_URL=http://localhost:8000
