# ORION environment configuration (example)
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Variable NAMES only here — no secrets belong in this file.

# -----------------------------------------------------------------------------
# Supabase — server / service-role configuration  (NEVER expose to the browser)
# -----------------------------------------------------------------------------
# Used by: backend/timetable Python ingestion (repository.py), admin tooling.
# The service-role key BYPASSES ROW LEVEL SECURITY. It must only live in
# server-side environments and is never imported into client bundles.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<service-role / secret key — server only>
# Management API token (supabase.com dashboard → account → access tokens).
# Used only by server-side admin tooling (scripts/supabase_sql.py). Optional.
SUPABASE_ACCESS_TOKEN=<personal access token — server only>
# Legacy alias for the same secret (either works; SUPABASE_SECRET_KEY preferred):
SUPABASE_SERVICE_ROLE_KEY=<service-role key — server only>

# -----------------------------------------------------------------------------
# Supabase — client / public configuration  (safe for browser bundles)
# -----------------------------------------------------------------------------
# Used by: request-scoped API clients (src/lib/supabase-server.ts) that forward
# the caller's verified JWT on the public anon key so auth.uid() and RLS apply.
# The anon key is designed to be public; security comes from RLS + JWTs.
SUPABASE_ANON_KEY=<public anon / publishable key>
# Optional aliases already used elsewhere in the repo:
SUPABASE_PUBLIC_ANON_KEY=<public anon key>
SUPABASE_PUBLISHABLE_KEY=<publishable key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public anon key>
PUBLIC_SUPABASE_ANON_KEY=<public anon key>

# -----------------------------------------------------------------------------
# Example variable-purpose matrix
# -----------------------------------------------------------------------------
# SUPABASE_URL / SUPABASE_SECRET_KEY      Python ingestion CLI (--import), admin
# SUPABASE_URL / SUPABASE_ANON_KEY        request-scoped timetable API clients
# VITE_/PUBLIC_ variants                  browser code, if client-side Supabase
#                                         is added later

# Rule of thumb (AGENTS.md §15/§32): if leaking a variable would let someone
# read or write data they should not, it is a server secret — keep it out of
# anything shipped to the browser.

# -----------------------------------------------------------------------------
# ORION FastAPI backend (backend/main.py + backend/app/) — local/dev only for now
# -----------------------------------------------------------------------------
# Reads this same repo-root .env (see backend/app/core/config.py). Never uses
# the service-role key to serve a user request — every route forwards the
# caller's own Supabase JWT via a request-scoped client (D6).
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:8080
# Set to "true" only once the app is served over https.
COOKIE_SECURE=false

# Google OAuth (PKCE) — consumed by backend/app/api/oauth.py, not the
# browser. Must match the Client ID/Secret actually registered in Supabase
# Dashboard → Authentication → Providers → Google, and
# {API_BASE_URL}/auth/oauth/google/callback must be added to Dashboard →
# Authentication → URL Configuration → Redirect URLs.
GOOGLE_CLIENT_ID=<google oauth client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>

# -----------------------------------------------------------------------------
# Frontend — browser-safe
# -----------------------------------------------------------------------------
# Where the browser sends auth/CR/admin API calls (backend/main.py). Not a
# Supabase variable — the browser no longer talks to Supabase directly.
VITE_API_BASE_URL=http://localhost:8000
